{
  "name": "gemeos-motors",
  "version": "2.0.0",
  "private": true,
  "description": "Gêmeos Motors — vitrine para o cliente e sistema de gestão da loja (CRM, funil, vendas, assistência).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrar.mjs",
    "db:seed": "node --env-file=.env.local scripts/semear.mjs",
    "test:ia:local": "node --env-file=.env.local scripts/simular-fluxo-ia.mts",
    "test:ia": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:limpar": "node --env-file=.env.local scripts/limpar-e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.75",
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-pdf/renderer": "^4.9.0",
    "ai": "^7.0.113",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "music-metadata": "^11.16.1",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
