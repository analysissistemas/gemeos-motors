codebase/
.git/

# ---- O que NAO sobe para a Vercel ----
# A Vercel compila o Next.js lá; daqui só vai o código-fonte e o que o site
# usa: app/, components/, lib/, public/ (vitrine, .js, fotos .webp, vídeo
# da loja) e as configurações. O resto é material de trabalho: sem isto,
# cada deploy mandava ~130 MB e deixava as notas internas abertas.

# dependências e compilação local (a Vercel instala e compila do zero)
node_modules/
.next/
tsconfig.tsbuildinfo

# segredos locais: na Vercel as variáveis vêm do painel do projeto
.env*

# notas do projeto e scripts de manutenção
CLAUDE.md
README.md
*.py
scripts/

# testes de ponta a ponta e seus relatórios
tests/
test-results/
playwright-report/
playwright.config.ts

# rascunhos, testes e arquivo morto (tudo que comeca com _, em qualquer pasta,
# incluindo public/fotos/_apple, _legado e _catalogo.json)
_*

# material do sistema antigo de celular e apresentacao em PowerPoint
apresentacao/
public/video/iphone-*.mp4

# originais pesados: o site usa o .webp
public/fotos/**/*.png
public/fotos/**/*.jpg
public/fotos/**/*.jpeg

# credenciais coladas em texto: nunca sobem
configuracoes-api-oficial.txt
